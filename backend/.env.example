# Copy to .env and fill in. NEVER commit .env. Placeholder names only here.
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Supabase Postgres (sync driver). From Supabase → Project settings → Database.
# Example shape: postgresql+psycopg://postgres:<password>@<host>:5432/postgres
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# NOTE — Google OAuth credentials do NOT go here:
#  - NoteFlow LOGIN with Google: set the Google client ID + secret in the Supabase
#    dashboard (Authentication -> Providers -> Google). The backend only verifies the
#    Supabase JWT above; it never sees Google credentials.
#  - Google CALENDAR access (Phase 11): a SEPARATE Google OAuth client configured in the
#    Recall dashboard (Calendar V2) — also not stored in this backend .env.

# Recall.ai (backend only)
RECALL_API_KEY=
RECALL_REGION=ap-northeast-1
RECALL_WORKSPACE_VERIFICATION_SECRET=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# AssemblyAI — only if NoteFlow calls it directly. Normally configured INSIDE Recall
# (same region), in which case leave this blank.
ASSEMBLYAI_API_KEY=
